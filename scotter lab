<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Meine Produkte</title>
  <style>
    :root {
      --bg: #07140d;
      --bg-2: #0d1d16;
      --panel: rgba(16, 28, 22, 0.96);
      --line: rgba(255,255,255,0.09);
      --text: #ecfff5;
      --muted: #c7dacc;
      --accent: #8ef2a3;
      --accent-strong: #34d77c;
      --shadow: 0 18px 40px rgba(0, 0, 0, 0.32);
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      min-height: 100vh;
      background: linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 100%);
      color: var(--text);
      font-family: "Segoe UI", Tahoma, sans-serif;
    }

    a { text-decoration: none; color: inherit; }
    button, input, textarea { font: inherit; }

    .page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 28px 20px 80px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 26px;
      padding: 18px 20px;
      background: rgba(12, 22, 18, 0.8);
      border: 1px solid var(--line);
      border-radius: 18px;
      backdrop-filter: blur(8px);
      position: sticky;
      top: 12px;
      z-index: 15;
    }

    .brand {
      display: flex;
      align-items: center;
      font-size: 1.2rem;
      font-weight: 800;
      letter-spacing: 0.03em;
    }

    .brand-mark {
      display: inline-grid;
      place-items: center;
      width: 36px;
      height: 36px;
      margin-right: 10px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--accent), var(--accent-strong));
      color: #06130d;
      font-weight: 900;
    }

    .header-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 18px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--accent), var(--accent-strong));
      color: #06130d;
      font-weight: 800;
      box-shadow: 0 12px 22px rgba(52, 215, 124, 0.22);
    }

    .hero {
      margin-bottom: 28px;
      padding: 28px 0 8px;
    }

    .hero h1 {
      margin: 0 0 12px;
      font-size: clamp(2.4rem, 5vw, 4.5rem);
      line-height: 0.96;
      letter-spacing: -0.06em;
    }

    .hero p {
      margin: 0;
      color: var(--muted);
      line-height: 1.8;
      max-width: 700px;
      font-size: 1.04rem;
    }

    .layout {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 24px;
      align-items: start;
    }

    .panel {
      background: linear-gradient(180deg, rgba(18, 33, 27, 0.96), rgba(10, 18, 15, 0.96));
      border: 1px solid var(--line);
      border-radius: 24px;
      box-shadow: var(--shadow);
      padding: 22px;
    }

    .panel h2 {
      margin: 0 0 20px;
      font-size: 1.6rem;
    }

    .field {
      margin-bottom: 16px;
    }

    .field label {
      display: block;
      margin-bottom: 8px;
      color: var(--muted);
      font-weight: 700;
    }

    .field input,
    .field textarea {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: rgba(255,255,255,0.02);
      color: var(--text);
      padding: 12px 13px;
    }

    .field textarea {
      min-height: 120px;
      resize: vertical;
    }

    .field input[type="file"] {
      padding: 10px;
    }

    .preview-box {
      display: none;
      width: 100%;
      min-height: 160px;
      max-height: 220px;
      margin-top: 12px;
      border: 1px dashed rgba(142, 242, 163, 0.35);
      border-radius: 14px;
      background: rgba(142, 242, 163, 0.05);
      overflow: hidden;
      align-items: center;
      justify-content: center;
    }

    .preview-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .submit-btn {
      width: 100%;
      margin-top: 6px;
      border: none;
      border-radius: 12px;
      padding: 13px 18px;
      background: linear-gradient(135deg, var(--accent), var(--accent-strong));
      color: #06130d;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 12px 22px rgba(52, 215, 124, 0.2);
    }

    .products-header {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 12px;
      margin: 30px 0 18px;
    }

    .products-header h2 {
      margin: 0;
      font-size: clamp(2rem, 4vw, 2.7rem);
      letter-spacing: -0.05em;
    }

    .products-header span {
      color: var(--muted);
      font-weight: 700;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }

    .product-card {
      background: rgba(17, 36, 29, 0.9);
      border: 1px solid var(--line);
      border-radius: 22px;
      overflow: hidden;
      box-shadow: var(--shadow);
      cursor: pointer;
      transition: transform 0.18s ease, border-color 0.18s ease;
    }

    .product-card:hover {
      transform: translateY(-3px);
      border-color: rgba(142, 242, 163, 0.42);
    }

    .product-card img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      display: block;
      background: rgba(255,255,255,0.04);
    }

    .product-info {
      padding: 16px;
    }

    .name-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 8px;
    }

    .name-row h3 {
      margin: 0;
      font-size: 1.1rem;
      line-height: 1.3;
    }

    .price {
      color: var(--accent);
      font-weight: 900;
      font-size: 1.05rem;
      white-space: nowrap;
    }

    .product-info p {
      margin: 0;
      color: var(--muted);
      line-height: 1.7;
    }

    .more {
      display: inline-block;
      margin-top: 12px;
      color: var(--accent);
      font-weight: 800;
    }

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 8, 6, 0.72);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 22px;
      z-index: 50;
    }

    .modal.show { display: flex; }

    .modal-content {
      width: min(760px, 100%);
      background: linear-gradient(180deg, #11261e, #08150f);
      border: 1px solid var(--line);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    .modal-image {
      display: block;
      width: 100%;
      height: 340px;
      object-fit: cover;
      background: rgba(255,255,255,0.05);
    }

    .modal-body {
      padding: 22px;
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }

    .modal-header h3 {
      margin: 0;
      font-size: 2rem;
      letter-spacing: -0.04em;
    }

    .close-btn {
      width: 40px;
      height: 40px;
      border: none;
      border-radius: 50%;
      background: rgba(255,255,255,0.05);
      color: var(--text);
      font-size: 1.3rem;
      cursor: pointer;
    }

    .modal-body p {
      margin: 0 0 14px;
      color: var(--muted);
      line-height: 1.8;
    }

    .modal-price {
      font-size: 1.5rem;
      font-weight: 900;
      color: var(--accent);
    }

    .contact-box {
      margin-top: 18px;
      background: rgba(142, 242, 163, 0.08);
      border: 1px solid rgba(142, 242, 163, 0.25);
      border-radius: 12px;
      padding: 14px 16px;
      font-weight: 800;
      color: var(--text);
    }

    @media (max-width: 900px) {
      .layout {
        grid-template-columns: 1fr;
      }

      .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .topbar {
        flex-wrap: wrap;
      }

      .product-grid {
        grid-template-columns: 1fr;
      }
    }

    body {
      display: flex;
      flex-direction: column;
    }

    .page {
      width: 100%;
      min-height: 100vh;
      padding-top: 22px;
    }

    .topbar {
      margin-bottom: 0;
    }

    .brand {
      font-size: 1.35rem;
    }

    .admin-button,
    .logout-button,
    .delete-button {
      border: 1px solid var(--line);
      border-radius: 10px;
      background: rgba(255,255,255,0.04);
      color: var(--text);
      cursor: pointer;
      padding: 9px 12px;
    }

    .admin-area {
      display: none;
      margin-top: 28px;
    }

    .admin-area.open {
      display: block;
    }

    .admin-area .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .admin-heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 18px;
    }

    .admin-heading h2 {
      margin: 0;
    }

    .admin-actions {
      display: flex;
      gap: 10px;
    }

    .product-grid:empty,
    .products-header:has(+ .product-grid:empty) {
      display: none;
    }

    .products-header:not(:has(+ .product-grid:empty)) {
      margin-top: 36px;
    }

    .login-layer {
      position: fixed;
      inset: 0;
      z-index: 60;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(0, 8, 6, 0.78);
    }

    .login-layer.show {
      display: flex;
    }

    .login-box {
      width: min(390px, 100%);
      padding: 24px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: #10231b;
      box-shadow: var(--shadow);
    }

    .login-box h2 {
      margin: 0 0 18px;
    }

    .login-actions {
      display: flex;
      gap: 10px;
    }

    .login-actions button {
      flex: 1;
    }

    .login-error {
      min-height: 1.4em;
      margin: 8px 0 0;
      color: #ff9d91;
    }

    .admin-product-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    @media (max-width: 640px) {
      .page { padding: 14px 14px 50px; }
      .brand { font-size: 1.1rem; }
      .admin-heading { align-items: flex-start; flex-direction: column; }
      .admin-actions { flex-wrap: wrap; }
    }
  </style>
</head>
<body>
  <div class="page">
    <header class="topbar">
      <div class="brand">Scottershop 24</div>
      <button class="admin-button" id="openLogin" type="button" aria-label="Adminbereich öffnen" title="Adminbereich öffnen">⚙</button>
    </header>

    <section id="adminArea" class="admin-area" aria-label="Produktverwaltung">
      <div class="admin-heading">
        <h2>Produkte verwalten</h2>
        <div class="admin-actions">
          <button class="logout-button" id="exportProducts" type="button">Produkte exportieren</button>
          <button class="logout-button" id="logoutButton" type="button">Abmelden</button>
        </div>
      </div>

      <section class="panel">
        <h2>Produkt hinzufügen</h2>
        <form id="productForm">
          <div class="field">
            <label for="productName">Name</label>
            <input id="productName" type="text" required />
          </div>
          <div class="field">
            <label for="productDescription">Beschreibung</label>
            <textarea id="productDescription" required></textarea>
          </div>
          <div class="field">
            <label for="productPrice">Preis</label>
            <input id="productPrice" type="text" required />
          </div>
          <div class="field">
            <label for="productImage">Bild hochladen</label>
            <input id="productImage" type="file" accept="image/*" />
          </div>
          <div id="previewBox" class="preview-box">
            <img id="imagePreview" alt="Bildvorschau" />
          </div>
          <button class="submit-btn" type="submit">Produkt speichern</button>
        </form>
      </section>
    </section>

    <div class="products-header">
      <h2>Produkte</h2>
      <span id="productCount">0</span>
    </div>
    <section id="productGrid" class="product-grid" aria-live="polite"></section>
  </div>

  <div id="loginLayer" class="login-layer" aria-hidden="true">
    <form id="loginForm" class="login-box">
      <h2>Anmeldung</h2>
      <div class="field">
        <label for="accessCode">Zugangscode</label>
        <input id="accessCode" type="password" autocomplete="current-password" required />
      </div>
      <div class="login-actions">
        <button class="submit-btn" type="submit">Anmelden</button>
        <button class="logout-button" id="cancelLogin" type="button">Abbrechen</button>
      </div>
      <p id="loginError" class="login-error" role="alert"></p>
    </form>
  </div>

  <div id="productModal" class="modal" aria-hidden="true">
    <div class="modal-content">
      <img id="modalImage" class="modal-image" alt="Produktbild" />
      <div class="modal-body">
        <div class="modal-header">
          <h3 id="modalTitle">Produkt</h3>
          <button class="close-btn" id="closeModal" aria-label="Schließen">×</button>
        </div>
        <p id="modalDescription"></p>
        <p id="modalPrice" class="modal-price"></p>
        <div class="contact-box">Kaufen? Schreib Timo auf Snap.</div>
      </div>
    </div>
  </div>

  <script>
    const storageKey = 'scottershop24_products';
    const accessCode = 'tanmafakent85jgndsgon';
    const defaultProducts = [
      {
        id: 1,
        name: 'Segway ZT3 Pro Bildschirmblende',
        description: 'Segway Bildschirmblende, Sonnenschutz',
        price: '6 €',
        image: ''
      }
    ];
    const productForm = document.getElementById('productForm');
    const productGrid = document.getElementById('productGrid');
    const productCount = document.getElementById('productCount');
    const productImage = document.getElementById('productImage');
    const imagePreview = document.getElementById('imagePreview');
    const previewBox = document.getElementById('previewBox');
    const productModal = document.getElementById('productModal');
    const loginLayer = document.getElementById('loginLayer');
    const adminArea = document.getElementById('adminArea');
    let products = loadProducts();

    function loadProducts() {
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) || '[]');
        if (Array.isArray(saved) && saved.length) return saved;
        return [...defaultProducts];
      } catch {
        return [...defaultProducts];
      }
    }

    function saveProducts() {
      try {
        localStorage.setItem(storageKey, JSON.stringify(products));
        return true;
      } catch {
        alert('Speichern fehlgeschlagen. Das Bild ist möglicherweise zu groß.');
        return false;
      }
    }

    async function loadPublishedProducts() {
      try {
        if (localStorage.getItem(storageKey)) return;

        const response = await fetch('./scottershop24-produkte(1).json');
        if (!response.ok) return;

        const publishedProducts = await response.json();
        if (Array.isArray(publishedProducts) && publishedProducts.length) {
          products = publishedProducts;
          renderProducts();
        }
      } catch {
        // Local files cannot fetch sibling files; keep the built-in products there.
      }
    }

    document.getElementById('exportProducts').addEventListener('click', () => {
      if (!products.length) {
        alert('Füge zuerst mindestens ein Produkt hinzu.');
        return;
      }

      const file = new Blob([JSON.stringify(products, null, 2)], { type: 'application/json' });
      const downloadUrl = URL.createObjectURL(file);
      const downloadLink = document.createElement('a');
      downloadLink.href = downloadUrl;
      downloadLink.download = 'scottershop24-produkte.json';
      downloadLink.click();
      URL.revokeObjectURL(downloadUrl);
    });

    function renderProducts() {
      productGrid.replaceChildren();
      productCount.textContent = String(products.length);

      products.forEach((product) => {
        const card = document.createElement('article');
        card.className = 'product-card';
        card.tabIndex = 0;

        const image = document.createElement('img');
        image.src = product.image || '';
        image.alt = product.name;
        const info = document.createElement('div');
        info.className = 'product-info';
        const nameRow = document.createElement('div');
        nameRow.className = 'name-row';
        const name = document.createElement('h3');
        name.textContent = product.name;
        const price = document.createElement('span');
        price.className = 'price';
        price.textContent = product.price;
        const description = document.createElement('p');
        description.textContent = product.description.length > 85
          ? `${product.description.slice(0, 85)}…`
          : product.description;
        const more = document.createElement('span');
        more.className = 'more';
        more.textContent = 'Mehr Details';
        nameRow.append(name, price);
        info.append(nameRow, description, more);

        if (sessionStorage.getItem('scottershop24_admin') === 'true') {
          const adminRow = document.createElement('div');
          adminRow.className = 'admin-product-row';
          const adminLabel = document.createElement('span');
          adminLabel.textContent = 'Verwaltung';
          const deleteButton = document.createElement('button');
          deleteButton.type = 'button';
          deleteButton.className = 'delete-button';
          deleteButton.textContent = 'Löschen';
          deleteButton.addEventListener('click', (event) => {
            event.stopPropagation();
            products = products.filter((item) => item.id !== product.id);
            if (saveProducts()) renderProducts();
          });
          adminRow.append(adminLabel, deleteButton);
          info.append(adminRow);
        }

        card.append(image, info);
        card.addEventListener('click', () => openProduct(product));
        card.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openProduct(product);
          }
        });
        productGrid.append(card);
      });
    }

    function openProduct(product) {
      document.getElementById('modalTitle').textContent = product.name;
      document.getElementById('modalDescription').textContent = product.description;
      document.getElementById('modalPrice').textContent = product.price;
      const modalImage = document.getElementById('modalImage');
      modalImage.hidden = !product.image;
      if (product.image) modalImage.src = product.image;
      productModal.classList.add('show');
      productModal.setAttribute('aria-hidden', 'false');
    }

    function closeProduct() {
      productModal.classList.remove('show');
      productModal.setAttribute('aria-hidden', 'true');
    }

    function setLoggedIn(loggedIn) {
      sessionStorage.setItem('scottershop24_admin', String(loggedIn));
      adminArea.classList.toggle('open', loggedIn);
      renderProducts();
    }

    document.getElementById('openLogin').addEventListener('click', () => {
      if (sessionStorage.getItem('scottershop24_admin') === 'true') {
        adminArea.classList.toggle('open');
        renderProducts();
        return;
      }
      loginLayer.classList.add('show');
      loginLayer.setAttribute('aria-hidden', 'false');
      document.getElementById('accessCode').focus();
    });

    document.getElementById('cancelLogin').addEventListener('click', () => {
      loginLayer.classList.remove('show');
      loginLayer.setAttribute('aria-hidden', 'true');
    });

    document.getElementById('loginForm').addEventListener('submit', (event) => {
      event.preventDefault();
      const enteredCode = document.getElementById('accessCode').value;
      if (enteredCode !== accessCode) {
        document.getElementById('loginError').textContent = 'Der Code stimmt nicht.';
        return;
      }

      document.getElementById('loginError').textContent = '';
      document.getElementById('loginForm').reset();
      loginLayer.classList.remove('show');
      loginLayer.setAttribute('aria-hidden', 'true');
      setLoggedIn(true);
    });

    document.getElementById('logoutButton').addEventListener('click', () => setLoggedIn(false));

    document.getElementById('closeModal').addEventListener('click', closeProduct);
    productModal.addEventListener('click', (event) => {
      if (event.target === productModal) closeProduct();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeProduct();
    });

    productImage.addEventListener('change', () => {
      const file = productImage.files && productImage.files[0];
      if (!file) {
        previewBox.style.display = 'none';
        return;
      }

      const reader = new FileReader();
      reader.onload = () => {
        imagePreview.src = reader.result;
        previewBox.style.display = 'flex';
      };
      reader.readAsDataURL(file);
    });

    productForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const name = document.getElementById('productName').value.trim();
      const description = document.getElementById('productDescription').value.trim();
      const price = document.getElementById('productPrice').value.trim();
      const file = productImage.files && productImage.files[0];

      const addProduct = (image) => {
        products.unshift({ id: Date.now(), name, description, price, image });
        if (saveProducts()) {
          renderProducts();
          productForm.reset();
          previewBox.style.display = 'none';
        } else {
          products.shift();
        }
      };

      if (file) {
        const reader = new FileReader();
        reader.onload = () => addProduct(reader.result);
        reader.onerror = () => alert('Das Bild konnte nicht gelesen werden.');
        reader.readAsDataURL(file);
      } else {
        addProduct('');
      }
    });

    if (sessionStorage.getItem('scottershop24_admin') === 'true') {
      adminArea.classList.add('open');
    }
    renderProducts();
    loadPublishedProducts();
  </script>
</body>
</html>

